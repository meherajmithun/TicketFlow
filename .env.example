PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# Required once PostgreSQL-backed features are added.
DATABASE_URL=postgresql://ticketflow:ticketflow@localhost:5432/ticketflow
# Set a unique random value of at least 32 characters before running the API.
AUTH_TOKEN_SECRET=replace-this-with-a-unique-random-secret-at-least-32-characters
# Set these only on the server to provision the organizer account. Do not commit real credentials.
# ORGANIZER_EMAIL=organizer@example.com
# ORGANIZER_PASSWORD=replace-with-a-unique-secret-of-at-least-12-characters
